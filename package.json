{
  "name": "network-builder",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/game/tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint packages/ --max-warnings=0",
    "dev": "npm run dev --workspace @nb/game",
    "build": "npm run build --workspace @nb/game"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fast-check": "^4.10.2",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  }
}
